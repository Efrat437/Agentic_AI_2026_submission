{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Receipt Extraction Output",
  "type": "object",
  "properties": {
    "date": { "type": "string", "format": "date" },
    "total": { "type": "number" },
    "category": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "price": { "type": "number" },
          "quantity": { "type": "number", "default": 1 }
        },
        "required": ["name", "price"]
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "resolution": { "type": "string" },
        "filetype": { "type": "string" },
        "vendor": { "type": "string" },
        "ocr_confidence": { "type": "number" },
        "image_width": { "type": "number" },
        "image_height": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": { "type": "string" }
    },
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "missing_fields": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["date", "total", "category", "items", "meta"]
}